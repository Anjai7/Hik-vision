# Hikvision Terminal Configuration
HIKVISION_HOST=https://192.168.18.229
HIKVISION_USERNAME=admin
HIKVISION_PASSWORD=change_me
HIKVISION_VERIFY_TLS=false
HIKVISION_TIMEOUT=10000

# Database Connection (Supabase PostgreSQL)
# For Vercel Serverless / Production (Supabase Transaction Pooler, Port 6543):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

